# Copy to .env.docker for `docker compose --env-file .env.docker up -d --build`.
# Never commit .env.docker.

# Bundled Postgres: set a long random password (any characters are fine).
POSTGRES_PASSWORD=""
# External Postgres instead: set these, leave POSTGRES_PASSWORD empty, and run
# docker compose --env-file .env.docker up -d --build --no-deps app cron
DATABASE_URL=""
DIRECT_URL=""                   # only if DATABASE_URL goes through a pooler
NEXT_PUBLIC_SITE_URL=""         # e.g. https://rewards.example.com
NEXT_PUBLIC_REFERRAL_CODE="ZEEDUDE"
NEXT_PUBLIC_REFERRAL_URL="https://solpump.io/a/ZEEDUDE"
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_KICK_URL=""

# From: npm run admin:password -- "your strong password" --print
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

CRON_SECRET=""                  # 16+ random characters
DATA_PROVIDER="manual"
TRUST_PROXY_HEADERS="false"     # true behind a reverse proxy that sets X-Forwarded-For
APP_PORT="3000"
