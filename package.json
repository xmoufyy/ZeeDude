{
  "name": "zeedude-leaderboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx prisma/ensure-dev-db.ts",
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/prisma.mjs db push",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:sync-schema": "node scripts/prisma.mjs sync-schema",
    "postinstall": "node scripts/prisma.mjs generate",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "verify:concurrency": "node scripts/verify-concurrency-sqlite.mjs",
    "verify:postgres": "node scripts/verify-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
