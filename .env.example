# Copy to .env and fill in. Never commit .env.

# Database. SQLite file for local dev; a postgresql:// URL in production.
DATABASE_URL="file:./dev.db"
# Postgres only: non-pooled URL for migrations (same as DATABASE_URL without a pooler).
# DIRECT_URL=""

# Public site settings (safe to expose to the browser). On Vercel, SITE_URL
# defaults to the production domain; set it once you add a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_REFERRAL_CODE="ZEEDUDE"
NEXT_PUBLIC_REFERRAL_URL="https://solpump.io/a/ZEEDUDE"

# Social links. Leave blank to hide a link.
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_KICK_URL=""

# Admin login. Generate both with:
#   npm run admin:password -- "your strong password"          (writes to .env)
#   npm run admin:password -- "your strong password" --print  (prints for your host)
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# Data source for the scheduled refresh:
#   "manual" (default) = admin file imports + manual entry
#   "api"              = official SolPump partner API (stub until docs arrive)
DATA_PROVIDER="manual"
SOLPUMP_API_URL=""
SOLPUMP_API_KEY=""

# Secret the cron job must send as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/refresh. Vercel Cron sends it automatically. 16+ characters.
CRON_SECRET=""

# Create each week's period automatically (copying the last prize setup).
AUTO_CREATE_PERIODS="true"

# Show "data may be delayed" when a live race hasn't been updated for this long.
DATA_STALE_AFTER_MINUTES="1440"

# Where last-known-good copies are kept for outages (default: OS temp dir).
# FALLBACK_CACHE_DIR=""

# true only behind a reverse proxy you control that sets X-Forwarded-For
# (login rate limiting trusts it). On Vercel this is handled automatically.
TRUST_PROXY_HEADERS="false"

# Running more than one app instance? Give them all the same key (32 random
# bytes, base64) so Server Actions work across instances.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
